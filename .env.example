# Discord Bot 設定
DISCORD_TOKEN=your_bot_token_here
MY_USER_ID=your_discord_user_id_here

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# TTS 角色設定 (VITS-Umamusume Hugging Face Space)
TTS_SPEAKER=待兼诗歌剧 Matikane Tannhauser (Umamusume Pretty Derby)
TTS_LANGUAGE=简体中文
TTS_SPEED=1.0

# 系統音訊擷取設定（PyAudio）
# 執行 /devices 查看可用裝置，填入編號
# AUDIO_CAPTURE_DEVICE=0
# SILENCE_THRESHOLD=400    # VAD 音量閾值（越小越敏感）
# NOISE_THRESHOLD=3000     # 多人吵雜檢測閾值
